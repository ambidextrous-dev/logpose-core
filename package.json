{
  "name": "tinyleaps-core",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d db && PYTHONPATH=. python3 scripts/init_db.py",
    "init-db": "set -a; [ -f .env ] && . ./.env; set +a; PYTHONPATH=. python3 scripts/init_db.py"
  }
}
